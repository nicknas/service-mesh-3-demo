flowchart TB
  classDef metrics fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
  classDef external fill:#fafafa,stroke:#666,color:#333

  subgraph tracing["tracing-system (TempoStack)"]
    direction TB
    object_storage[(object storage)]
    ingester[ingester]
    querier[querier]
    compactor[compactor]
    distributor[distributor]
    query_frontend[query frontend]
    gateway[gateway]

    gateway -->|span| distributor
    gateway -.->|consulta| query_frontend
    distributor --> ingester
    query_frontend --> querier
    ingester --> object_storage
    querier --> object_storage
    compactor -.-> ingester
  end

  subgraph istio["istio-system"]
    direction TB
    istiod[istiod]
    istio_service[istio service]
    service_monitor[service monitor]
    otel_collector[otel collector]
    otel_collector_service[otel collector service]

    service_monitor --> istio_service
    istio_service --> istiod
    otel_collector_service --> otel_collector
  end

  subgraph bookinfo["bookinfo"]
    direction TB
    subgraph bookinfo_pod["bookinfo app pod"]
      direction TB
      sidecar[sidecar]
      app_container[bookinfo app container]
    end
    pod_monitor[pod monitor]
  end

  prom[["prometheus (métricas)"]]:::metrics

  consulta_tempo([consulta]):::external -.-> gateway
  consulta_istio([consulta]):::external -.-> istio_service
  consulta_app([consulta]):::external -.-> app_container

  sidecar -->|trazas push| otel_collector_service
  otel_collector -->|span| gateway

  prom -.->|configura| service_monitor
  prom -.->|configura| pod_monitor
  prom ==>|métricas pull| service_monitor
  prom ==>|métricas pull| sidecar
